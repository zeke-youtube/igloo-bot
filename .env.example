DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_client_id
GUILD_ID=your_pikastudio_server_id
ANNOUNCEMENTS_CHANNEL_ID=your_announcements_channel_id
STAFF_LIST_CHANNEL_ID=your_staff_list_channel_id
COMMANDS_ONLY_CHANNEL_ID=your_commands_only_channel_id
TYPING_CHANNEL_ID=your_typing_channel_id
FISH_DROP_CHANNEL_ID=your_fish_drop_channel_id
FISH_DROP_INTERVAL_MS=600000
KTV_CATEGORY_ID=your_ktv_category_id
KTV_RENTAL_PRICE=5
PIKAPENG_EMOJI_ID=your_custom_pikapeng_emoji_id
STAFF_ROLE_IDS=your_staff_role_id_1,your_staff_role_id_2
# Set true only if you intentionally want announcement text mentions to notify users.
ALLOW_ANNOUNCEMENT_MENTIONS=false
TYPERACE_CHANNEL_ID=your_typerace_channel_id
WADDLE_RACE_ACTIVITY_WINDOW_MS=3600000
WADDLE_RACE_MIN_INTERVAL_MS=600000
WADDLE_RACE_MAX_INTERVAL_MS=1200000
WADDLE_RACE_REWARD=25
WADDLE_RACE_MAX_ANSWER_LENGTH=1800
SECRET_SHIELD_ENABLED=true
SECRET_SHIELD_WARN_USER=true
PIKACLOUD_STORAGE_DIR=/app/src/data/pikacloud-files
